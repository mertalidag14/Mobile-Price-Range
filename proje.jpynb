   "source": [
    "# Veri setini yüklüyoruz (Dosya adını kendi klasörüne göre düzenleyebilirsin)\n",
    "# Örnek: df = pd.read_csv('train.csv')\n",
    "try:\n",
    "    df = pd.read_csv('train.csv')\n",
    "    print(\"[BAŞARILI] Veri seti yüklendi. Satır/Sütun:\", df.shape)\n",
    "    \n",
    "    # KONTROL İÇİN: İlk 5 satırı ekrana yazdıralım\n",
    "    print(\"\\n[INFO] Veri Setinden İlk 5 Satır:\")\n",
    "    display(df.head()) # Eğer Jupyter Notebook kullanıyorsan display() en şık görüntüyü verir. Düz terminal/script için print(df.head()) yapabilirsin.\n",
    "\n",
    "except FileNotFoundError:\n",
    "    print(\"[HATA] 'train.csv' dosyası bulunamadı. Lütfen dosya yolunu kontrol et.\")\n",
    "\n",
    "# Hedef değişken (y) ve bağımsız değişkenler (X) ayrımı\n",
    "# Not: Hedef sütun adı 'price_range' varsayılmıştır.\n",
    "if 'df' in globals():\n",
    "    X = df.drop('price_range', axis=1)\n",
    "    y = df['price_range']\n",
    "\n",
    "    # Veriyi %80 Eğitim, %20 Test olarak bölme (Train-Test Split)\n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        X, y, test_size=0.20, random_state=42\n",
    "    )\n",
    "\n",
    "    print(f\"\\n[INFO] Eğitim seti boyutu (X_train): {X_train.shape}\")\n",
    "    print(f\"[INFO] Test seti boyutu (X_test): {X_test.shape}\")\n",
    "\n",
    "    # KNN ve Random Forest modelleri için boş şablonlar\n",
    "    knn_model = KNeighborsClassifier()\n",
    "    rf_model = RandomForestClassifier(random_state=42)\n",
    "\n",
    "    print(\"\\n[BAŞARILI] KNN ve Random Forest model şablonları hazırlandı.\")\n",
    "    from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# KNN için verileri ölçeklendirme (StandardScaler)\n",
    "scaler = StandardScaler()\n",
    "\n",
    "# Eğitim verisini ölçeklendiriyoruz\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "\n",
    "# Test verisini aynı ölçekleyici ile dönüştürüyoruz (Veri sızıntısını önlemek için fit_transform DEĞİL, sadece transform)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "print(\"\\n[BAŞARILI] KNN için veriler StandardScaler ile ölçeklendirildi.\")\n",
    "print(\"[INFO] Random Forest için ise ham (ölçeklendirilmemiş) X_train ve X_test verileri kullanılmaya hazır.\")  \n",
    "from sklearn.metrics import accuracy_score, classification_report\n",
    "\n",
    "print(\"--- 2. MODELLERİN EĞİTİLMESİ VE DEĞERLENDİRİLMESİ ---\\n\"\n",
    ")\n",
    "\n",
    "# 1. KNN Modeli Eğitimi (Ölçeklendirilmiş verilerle)\n",
    "# Not: Daha önce hazırladığımız X_train_scaled ve X_test_scaled kullanılıyor.\n",
    "knn_model.fit(X_train_scaled, y_train)\n",
    "y_pred_knn = knn_model.predict(X_test_scaled)\n",
    "accuracy_knn = accuracy_score(y_test, y_pred_knn)\n",
    "\n",
    "print(f\"-> KNN Model Başarı Oranı (Accuracy): %{accuracy_knn * 100:.2f}\")\n",
    "\n",
    "\n",
    "# 2. Random Forest Modeli Eğitimi (Ham/Ölçeklendirilmemiş verilerle)\n",
    "rf_model.fit(X_train, y_train)\n",
    "y_pred_rf = rf_model.predict(X_test)\n",
    "accuracy_rf = accuracy_score(y_test, y_pred_rf)\n",
    "\n",
    "print(f\"-> Random Forest Model Başarı Oranı (Accuracy): %{accuracy_rf * 100:.2f}\")\n",
    "\n",
    "\n",
    "# Detaylı Sınıflandırma Raporu (İsteğe bağlı inceleme için)\n",
    "print(\"\\n--- KNN Sınıflandırma Raporu ---\")\n",
    "print(classification_report(y_test, y_pred_knn))\n",
    "\n",
    "print(\"\\n--- Random Forest Sınıflandırma Raporu ---\")\n",
    "print(classification_report(y_test, y_pred_rf))\n"
   ]
  }
 ],
